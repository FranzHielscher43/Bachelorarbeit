[node name="Hologram_01" parent="Holograms" unique_id=1431682723 instance=ExtResource("31_hgnya")]
z_index = 50
position = Vector2(-4, 0)
hologram_description = "[ENTER]"
info_description = "An object is a instance of a class.

EnergyCore_A and EnergyCore_B belong to 
the same class.

They share the same attribute types, but 
their values may differ.

Every object is unique."
dialogbox_path = NodePath("../../Dialogbox")

[node name="Hologram_02" parent="Holograms" unique_id=1719365294 instance=ExtResource("31_hgnya")]
z_index = 50
position = Vector2(-387.99997, -228)
hologram_title = "CLASS"
hologram_description = "[ENTER]"
info_title = "CLASS"
info_description = "A class describes what an object 
looks like.

It defines which attributes and methods 
every object of this type possesses.

Objects can be created from  this 
\"blueprint\"."
dialogbox_path = NodePath("../../Dialogbox")

[node name="Hologram_03" parent="Holograms" unique_id=429628100 instance=ExtResource("31_hgnya")]
z_index = 50
position = Vector2(-531.9999, 121)
hologram_title = "ATTRIBUTE"
hologram_description = "[ENTER]"
info_title = "ATTRIBUTE"
info_description = "Attributes store information about 
an object.

Example:

EnergyCore_B
capacity = 90
stability = 95
state = stable

Different objects can have different 
attribute values."
dialogbox_path = NodePath("../../Dialogbox")

[node name="Hologram_04" parent="Holograms" unique_id=1831553138 instance=ExtResource("31_hgnya")]
