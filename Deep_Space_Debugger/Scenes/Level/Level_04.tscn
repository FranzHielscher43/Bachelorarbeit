hologram_description = "[ENTER]"
info_title = "COMMUNICATION"
info_description = "Objects rarely work alone.

Instead of changing other objects 
directly,they communicate by calling 
methods.

This allows complex systems to cooperate
while each object remains responsible
for its own behavior."
dialogbox_path = NodePath("../../Dialogbox")

