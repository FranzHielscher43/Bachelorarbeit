hologram_title = "DIFFERENCES"
hologram_description = "[ENTER]"
info_title = "DIFFERENCES"
info_description = "Different objects can receive the 
same method call.

Each object responds according to
its own implementation.

The sender uses one common interface,
while every receiver performs
its specialized behavior."
