hologram_title = "INHERITANCE"
hologram_description = "[ENTER]"
info_title = "INHERITANCE"
info_description = "Inheritance allows a class to build 
upon another class.

A child class automatically receives 
the attributes and methods of its 
parent class.

This promotes code reuse and reduces 
duplication."
